pipeline {
    agent {
        label 'jenkins-agent'
    }

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = 'tommasofranco/flask-app'
        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Calcola tag immagine') {
            steps {
                script {
                    if (env.TAG_NAME) {
                        env.IMAGE_TAG = env.TAG_NAME
                    } else if (env.BRANCH_NAME == 'master') {
                        env.IMAGE_TAG = 'latest'
                    } else if (env.BRANCH_NAME == 'develop') {
                        env.IMAGE_TAG = "develop-${env.GIT_COMMIT}"
                    } else {
                        error("Branch non supportato: ${env.BRANCH_NAME}")
                    }

                    echo "Immagine: ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build immagine') {
            steps {
                dir('TRACK_2/step_2/app') {
                    script {
                        docker.build(
                            "${env.IMAGE_NAME}:${env.IMAGE_TAG}",
                            '.'
                        )
                    }
                }
            }
        }

        stage('Push immagine') {
            steps {
                script {
                    docker.withRegistry(
                        env.DOCKER_REGISTRY,
                        env.DOCKERHUB_CREDENTIALS
                    ) {
                        docker.image(
                            "${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                        ).push()
                    }
                }
            }
        }
    }
}
